generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Роли персонала. Ровно три — «наблюдателя» нет намеренно, см. shared/roles.ts.
enum Role {
  OWNER
  ADMIN
  MODERATOR
}

enum TicketStatus {
  OPEN
  CLOSED
}

enum ActorType {
  user
  ai
}

/// Состояние учётной записи.
/// pending_approval — создана Админом и ждёт решения ГМ; вход невозможен,
/// письмо с паролем не отправлено. rejected — ГМ отказал.
enum UserStatus {
  active
  pending_approval
  rejected
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  /// Ник СОТРУДНИКА панели — единственное его имя в системе: им он подписан
  /// в аудите, по нему ему пишут в личные сообщения, его же видит ГМ в
  /// доступах. Отдельного «отображаемого имени» нет намеренно: человек
  /// придумывает себе ник сам при первом входе, и второе имя, назначенное
  /// кем-то другим, только расходилось бы с ним.
  /// К нику игрока в Minecraft отношения не имеет — это разные сущности.
  /// Уникален по всей панели; null, пока не пройден первый вход.
  nickname      String?  @unique
  /// Разовое разрешение ГМ сменить себе ник. Гасится после смены: ник —
  /// это то, по чему человека знают коллеги, и менять его молча нельзя.
  nicknameChangeAllowed Boolean @default(false) @map("nickname_change_allowed")
  role          Role     @default(MODERATOR)
  isActive      Boolean  @default(true) @map("is_active")
  status        UserStatus @default(active)
  /// Кто создал запись. Нужен, чтобы показать ГМ автора заявки.
  createdById   String?  @map("created_by_id")
  /// Пароль одноразовый: до смены пускаем только на экран онбординга.
  mustChangePassword Boolean @default(false) @map("must_change_password")
  /// Срок годности одноразового пароля. После него вход невозможен.
  passwordExpiresAt  DateTime? @map("password_expires_at")
  totpSecretEnc String?  @map("totp_secret_enc")
  totpEnabled   Boolean  @default(false) @map("totp_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions         Session[]
  serverAccess     UserServerAccess[]
  sentMessages     StaffMessage[] @relation("StaffMessageFrom")
  receivedMessages StaffMessage[] @relation("StaffMessageTo")

  @@index([status])
  @@map("users")
}

/// Личное сообщение между сотрудниками панели.
///
/// Приватность обеспечивается на уровне запросов: выборка всегда идёт с
/// условием «текущий пользователь — отправитель либо получатель». Роли на
/// это не влияют: ГМ не видит чужую переписку так же, как и все остальные.
model StaffMessage {
  id         String    @id @default(uuid())
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  from       User      @relation("StaffMessageFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to         User      @relation("StaffMessageTo", fields: [toUserId], references: [id], onDelete: Cascade)
  text       String
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  /// Выборка диалога и счёт непрочитанных идут по этим парам.
  @@index([toUserId, readAt])
  @@index([fromUserId, toUserId, createdAt])
  @@map("staff_messages")
}

/// Настройки панели, не являющиеся секретами (секреты — в integration_secrets).
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  @@index([userId])
  @@map("sessions")
}

/// Зеркало серверов Pterodactyl + привязка игрового модуля + доп. креды.
model Server {
  id              String   @id @default(uuid())
  pteroId         Int      @unique @map("ptero_id")
  pteroIdentifier String   @unique @map("ptero_identifier")
  pteroUuid       String   @unique @map("ptero_uuid")
  name            String
  description     String?
  node            String?
  status          String?
  /// Основная аллокация из Pterodactyl: по этому адресу игроки заходят на сервер.
  /// Обновляется при синке; alias — доменное имя, если оно задано в Pterodactyl.
  allocationIp    String?  @map("allocation_ip")
  allocationAlias String?  @map("allocation_alias")
  allocationPort  Int?     @map("allocation_port")
  /// id игрового модуля из реестра (null — модуль не назначен)
  moduleId        String?  @map("module_id")
  /// AES-256-GCM-шифрованный JSON с доп. кредами (RCON и т.п.)
  credentialsEnc  String?  @map("credentials_enc")
  /// Лимиты из Pterodactyl, обновляются при синке. 0 — без ограничения.
  /// Нужны, чтобы показывать «занято из», а не голое число байт.
  memoryLimitMb   Int?     @map("memory_limit_mb")
  diskLimitMb     Int?     @map("disk_limit_mb")
  cpuLimitPercent Int?     @map("cpu_limit_percent")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  access          UserServerAccess[]
  tickets         Ticket[]
  minecraftBans   MinecraftBan[]
  palworldBans    PalworldBan[]
  sevenDaysEvents SevenDaysEvent[]
  activitySamples ServerActivitySample[]
  metrics         ServerMetricSample?
  alertStates     ServerAlertState[]

  @@map("servers")
}

/// Последний снимок нагрузки сервера. РОВНО ОДНА строка на сервер.
///
/// Именно снимок, а не история: список серверов показывает «сейчас», а не
/// график, и хранить ряд на каждый опрос значило бы растить таблицу
/// бесконечно ради данных, которые никто не читает. История нагрузки — это
/// отдельная задача с агрегацией по времени, как у ServerActivitySample.
///
/// Нужен он в базе, а не в памяти процесса, по двум причинам: список
/// серверов не должен ходить в Pterodactyl за каждым сервером на каждое
/// открытие (десятки серверов — десятки запросов), и снимок должен пережить
/// перезапуск панели, иначе после деплоя карточки полминуты стоят пустыми.
model ServerMetricSample {
  serverId    String   @id @map("server_id")
  server      Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// running / offline / starting / stopping
  state       String?
  /// Сырое значение Pterodactyl: 200 = два ядра целиком.
  cpuAbsolute Float?   @map("cpu_absolute")
  memoryBytes BigInt?  @map("memory_bytes")
  /// Игроки от игрового модуля. null — модуля нет или он не ответил;
  /// это НЕ то же самое, что ноль игроков.
  playersOnline Int?   @map("players_online")
  playersMax    Int?   @map("players_max")
  sampledAt   DateTime @default(now()) @map("sampled_at")

  @@map("server_metric_samples")
}

/// Состояние одного вида алерта по одному серверу.
///
/// Здесь живут две вещи, без которых алерты превращаются в спам:
///   breachingSince — момент, с которого превышение держится непрерывно.
///     Письмо уходит, только если оно продержалось дольше настроенного
///     времени: сервер уходит в потолок на запуске и на генерации чанков, и
///     мгновенный триггер сделал бы почту нечитаемой в первую же неделю.
///   lastNotifiedAt — когда в последний раз отправили. Пока проблема длится,
///     повтор возможен не чаще кулдауна.
///
/// Строка на пару (сервер, тип), а не на событие: это именно СОСТОЯНИЕ, а
/// журнал отправленных писем и так есть в audit_log.
model ServerAlertState {
  serverId       String    @map("server_id")
  server         Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// Вид алерта: cpu, memory и всё, что появится дальше.
  type           String
  /// С какого момента порог превышен непрерывно. null — сейчас всё в норме.
  breachingSince DateTime? @map("breaching_since")
  lastNotifiedAt DateTime? @map("last_notified_at")
  /// Значение в процентах от лимита на момент последней отправки — для письма.
  lastValue      Float?    @map("last_value")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@id([serverId, type])
  @@map("server_alert_states")
}

/// Замер числа игроков онлайн: по ним строится график активности.
/// Один ряд на сервер и часовой слот — повторные замеры внутри часа
/// усредняются на месте, чтобы таблица не росла линейно по времени.
model ServerActivitySample {
  serverId  String   @map("server_id")
  /// Начало часа в UTC, к которому относится замер.
  bucket    DateTime
  /// Среднее число игроков за час.
  avgOnline Float    @map("avg_online")
  /// Пик за час — по нему видно, что «в среднем двое» это 0 и 4.
  maxOnline Int      @map("max_online")
  /// Сколько замеров усреднено: нужно для пересчёта среднего без хранения истории.
  samples   Int      @default(1)
  server    Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([serverId, bucket])
  @@index([serverId, bucket])
  @@map("server_activity_samples")
}

/// Server-scoped доступ: Admin/Moderator видит только привязанные сервера.
model UserServerAccess {
  userId   String @map("user_id")
  serverId String @map("server_id")
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@id([userId, serverId])
  @@map("user_server_access")
}

/// Зашифрованные интеграционные секреты (ключи Pterodactyl API и т.п.).
model IntegrationSecret {
  key       String   @id
  valueEnc  String   @map("value_enc")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("integration_secrets")
}

model Ticket {
  id               String       @id @default(uuid())
  serverId         String       @map("server_id")
  server           Server       @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerUuid       String       @map("player_uuid")
  playerNameCached String       @map("player_name_cached")
  status           TicketStatus @default(OPEN)
  /// [{ text, from, created_at }]
  messages         Json         @default("[]")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  @@index([serverId, status])
  @@index([status])
  @@map("tickets")
}

/// Баны модуля Minecraft. Источник истины о причине, сроке и модераторе;
/// на самом сервере бан ставится RCON-командой для мгновенного эффекта.
/// События игрового сервера 7 Days to Die, присланные companion-модом.
///
/// Своей таблицы у модуля не было и для банов не нужно — их ведёт сам
/// игровой сервер. А вот события он нигде не хранит: они происходят и
/// исчезают. Панель их складывает сюда, потому что смысл именно в разборе
/// задним числом — «кто кого убил на PvE» и «что было в чате перед
/// жалобой» спрашивают уже после случившегося.
///
/// Таблица растёт быстро (чат живого сервера), поэтому старое подрезается
/// при приёме — см. SevenDaysEventsService.
model SevenDaysEvent {
  id         String   @id @default(uuid())
  serverId   String   @map("server_id")
  server     Server   @relation(fields: [serverId], references: [id], onDelete: Cascade)
  /// chat | join | leave | death | player-kill
  kind       String
  /// Идентификатор платформы: Steam_… или EOS_…
  playerId   String   @map("player_id")
  playerName String   @map("player_name")
  /// Текст — только у событий чата.
  text       String?
  /// Кто убил, для player-kill: жертва в playerId, убийца здесь.
  actorId    String?  @map("actor_id")
  actorName  String?  @map("actor_name")
  /// Место происшествия. Нужно для разбора жалоб, а не для карты.
  x          Float?
  y          Float?
  z          Float?
  /// Время по данным игрового сервера, а не по времени приёма: события
  /// могли пролежать в очереди мода, пока панель была недоступна.
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([serverId, occurredAt])
  @@index([serverId, kind, occurredAt])
  @@map("mod_sevendays_events")
}

model MinecraftBan {
  id           String    @id @default(uuid())
  serverId     String    @map("server_id")
  server       Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerName   String    @map("player_name")
  playerUuid   String?   @map("player_uuid")
  reason       String
  /// null — бан навсегда
  expiresAt    DateTime? @map("expires_at")
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  /// проставляется при снятии вручную или кроном по истечении срока
  pardonedAt   DateTime? @map("pardoned_at")
  /// null при автоснятии по сроку
  pardonedById String?   @map("pardoned_by_id")

  @@index([serverId, pardonedAt])
  @@index([pardonedAt, expiresAt])
  @@map("mod_minecraft_bans")
}

/// Баны Palworld.
///
/// Своя таблица нужна потому, что REST API Palworld умеет банить и
/// разбанивать, но НЕ умеет отдавать список банов. Без неё вкладка банов
/// могла бы только «забанить в пустоту»: ни причины, ни кто забанил, ни
/// возможности снять бан по списку.
///
/// Срока у бана нет намеренно: сам сервер временных банов не поддерживает,
/// а показывать срок, который никто не соблюдает, значит врать.
model PalworldBan {
  id           String    @id @default(uuid())
  serverId     String    @map("server_id")
  server       Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  playerName   String    @map("player_name")
  /// userId платформы (напр. steam_011...) — то, чем оперирует сам сервер.
  userId       String    @map("user_id")
  reason       String
  createdById  String?   @map("created_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  pardonedAt   DateTime? @map("pardoned_at")
  pardonedById String?   @map("pardoned_by_id")

  @@index([serverId, pardonedAt])
  @@map("mod_palworld_bans")
}

model AuditLog {
  id         BigInt    @id @default(autoincrement())
  actorId    String?   @map("actor_id")
  actorType  ActorType @default(user) @map("actor_type")
  /// От чьего имени действовал не-человек. Для actor_type=ai — id сотрудника,
  /// который вёл диалог с ассистентом и подтвердил действие. Без этого поля
  /// в журнале осталось бы «сделал ИИ», и концов не найти.
  onBehalfOf String?   @map("on_behalf_of")
  action     String
  targetType String?   @map("target_type")
  targetId   String?   @map("target_id")
  metadata   Json?
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@index([onBehalfOf])
  @@map("audit_log")
}

/// Расход на обращения к DeepSeek: по нему считаются лимиты и деньги.
model AiUsageLog {
  id               BigInt   @id @default(autoincrement())
  userId           String   @map("user_id")
  model            String
  promptTokens     Int      @default(0) @map("prompt_tokens")
  completionTokens Int      @default(0) @map("completion_tokens")
  /// Сколько инструментов вызвано за обращение — видно, кто «гоняет» модель.
  toolCalls        Int      @default(0) @map("tool_calls")
  /// Текст ошибки, если обращение не удалось. null — успех.
  error            String?
  createdAt        DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("ai_usage_log")
}

/// Разрушительное действие, предложенное моделью и ждущее решения человека.
///
/// Хранится на сервере, а не в браузере: подтверждение должно исполнять
/// ровно то, что предложила модель. Если бы аргументы приезжали с клиента
/// вместе с подтверждением, «подтверждение» ничего бы не гарантировало.
model AiPendingAction {
  id        String   @id @default(uuid())
  /// Кто вёл диалог. Только он может подтвердить или отклонить.
  userId    String   @map("user_id")
  tool      String
  /// Аргументы вызова как их вернула модель.
  args      Json
  /// true — предложение появилось после того, как в контекст попали данные
  /// из игры (ники, тикеты, вывод консоли). Интерфейс предупреждает об этом
  /// отдельно: такой ввод недоверенный.
  fromUntrustedInput Boolean @default(false) @map("from_untrusted_input")
  status    AiActionStatus @default(pending)
  result    String?
  createdAt DateTime @default(now()) @map("created_at")
  resolvedAt DateTime? @map("resolved_at")

  @@index([userId, status])
  @@map("ai_pending_actions")
}

enum AiActionStatus {
  pending
  approved
  rejected
  failed
  /// Истекло по времени — старое предложение исполнять нельзя.
  expired
}
