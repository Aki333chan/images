# Конфигурация бэкапа. Кладётся в /etc/aurum-panel/backup.env
#   sudo install -m 0640 -o root -g aurum backup.env.example /etc/aurum-panel/backup.env
#
# Касается ТОЛЬКО базы панели. MariaDB Pterodactyl на домашнем сервере —
# отдельная система со своим бэкапом.

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=aurum
PGPASSWORD=ПАРОЛЬ_БД
PGDATABASE=aurum_panel

BACKUP_DIR=/var/backups/aurum-panel
KEEP_DAYS=14
