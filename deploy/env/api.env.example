# Продакшен-конфигурация API. Кладётся в /etc/aurum-panel/api.env
#
#   sudo install -d -m 0750 -o root -g aurum /etc/aurum-panel
#   sudo install -m 0640 -o root -g aurum api.env.example /etc/aurum-panel/api.env
#
# Права 0640 root:aurum — сервис читает, посторонние нет.
# Файл НИКОГДА не коммитится в репозиторий.

NODE_ENV=production

# ---------------------------------------------------------------- сеть
API_PORT=3001
# Адрес туннеля, а не 0.0.0.0: на публичном интерфейсе порт не слушается
# вовсе, поэтому API недоступен снаружи даже при ошибке в ufw.
# Сюда ходят nginx (с этой же машины) и companion-плагин (через туннель).
API_BIND=10.0.0.1
# Доверяем X-Forwarded-For только от своего nginx — иначе IP в списке
# сессий можно было бы подделать заголовком.
TRUST_PROXY=10.0.0.1
WEB_ORIGIN=https://manage.aurumgg.ovh

# ------------------------------------------------------------ хранилища
# Пароль подставьте из шага «создание БД» в DEPLOY.md.
DATABASE_URL=postgresql://aurum:ПАРОЛЬ_БД@127.0.0.1:5432/aurum_panel?schema=public
# Отдельный инстанс Redis на 6380 — Redis Pterodactyl на 6379 не трогаем.
REDIS_URL=redis://127.0.0.1:6380

# -------------------------------------------------------------- секреты
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600

# openssl rand -base64 32   (ровно 32 байта после декодирования)
# Этим ключом шифруются RCON-пароли и токены companion-плагина.
# ПОТЕРЯ КЛЮЧА = потеря всех сохранённых кредов серверов (их придётся ввести заново).
# СМЕНА КЛЮЧА на живой базе сделает уже сохранённые креды нечитаемыми.
APP_ENCRYPTION_KEY=

# --------------------------------------------------------- Pterodactyl
# Адрес Pterodactyl Panel. Схема и имя должны совпадать с тем, на что
# настроен её nginx.
#
# ВАЖНО, почему не http://127.0.0.1, хотя панель на этой же машине:
# её nginx принудительно уводит http на https редиректом 301. Запрос по
# http получает в ответ HTML-заглушку nginx вместо JSON, и синхронизация
# серверов падает. Пойти по редиректу тоже нельзя: он ведёт на
# https://127.0.0.1, а сертификат выписан на доменное имя, не на IP.
#
# Трафик при этом машину не покидает: домен указывает на её же адрес.
# Если хотите гарантированно замкнуть его на loopback — добавьте строку
# «127.0.0.1 panel.aurumgg.ovh» в /etc/hosts. Выпуску сертификатов это не
# мешает: проверка Let's Encrypt приходит снаружи и /etc/hosts не читает.
PTERO_BASE_URL=https://panel.aurumgg.ovh
# Admin -> Application API, права на чтение серверов.
PTERO_APP_API_KEY=
# Client API key служебного пользователя (Account -> API Credentials).
PTERO_CLIENT_API_KEY=
# После первого старта ключи шифруются и переносятся в БД —
# эти две строки можно очистить и перезапустить сервис.

# ------------------------------------------------- первый вход (сид)
# Используется один раз командой prisma:seed, потом можно очистить.
OWNER_EMAIL=
OWNER_PASSWORD=
# Ник владельца — его единственное имя в панели: под ним он виден коллегам
# в личных сообщениях и подписан в аудите. Остальные сотрудники выбирают ник
# сами при первом входе, а владелец первый вход не проходит — поэтому ник
# задаётся здесь. Прежнее имя переменной OWNER_NAME тоже понимается.
OWNER_NICKNAME=GM

# ------------------------------------------------------------ Письма
# Адрес панели для ссылок в письмах. Настройки SMTP задаются в интерфейсе
# (Настройки -> Почта) и хранятся зашифрованными, а не здесь.
PANEL_URL=https://manage.aurumgg.ovh
