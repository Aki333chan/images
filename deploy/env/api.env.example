# Продакшен-конфигурация API. Кладётся в /etc/aurum-panel/api.env
#
#   sudo install -d -m 0750 -o root -g aurum /etc/aurum-panel
#   sudo install -m 0640 -o root -g aurum api.env.example /etc/aurum-panel/api.env
#
# Права 0640 root:aurum — сервис читает, посторонние нет.
# Файл НИКОГДА не коммитится в репозиторий.

NODE_ENV=production

# ---------------------------------------------------------------- сеть
API_PORT=3001
# Адрес туннеля, а не 0.0.0.0: на публичном интерфейсе порт не слушается
# вовсе, поэтому API недоступен снаружи даже при ошибке в ufw.
# Сюда ходят nginx (с этой же машины) и companion-плагин (через туннель).
API_BIND=10.0.0.1
# Доверяем X-Forwarded-For только от своего nginx — иначе IP в списке
# сессий можно было бы подделать заголовком.
TRUST_PROXY=10.0.0.1
WEB_ORIGIN=https://manage.aurumgg.ovh

# ------------------------------------------------------------ хранилища
# Пароль подставьте из шага «создание БД» в DEPLOY.md.
DATABASE_URL=postgresql://aurum:ПАРОЛЬ_БД@127.0.0.1:5432/aurum_panel?schema=public
# Отдельный инстанс Redis на 6380 — Redis Pterodactyl на 6379 не трогаем.
REDIS_URL=redis://127.0.0.1:6380

# -------------------------------------------------------------- секреты
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600

# openssl rand -base64 32   (ровно 32 байта после декодирования)
# Этим ключом шифруются RCON-пароли и токены companion-плагина.
# ПОТЕРЯ КЛЮЧА = потеря всех сохранённых кредов серверов (их придётся ввести заново).
# СМЕНА КЛЮЧА на живой базе сделает уже сохранённые креды нечитаемыми.
APP_ENCRYPTION_KEY=

# --------------------------------------------------------- Pterodactyl
# Панель на этой же машине — ходим по localhost, не через публичный домен.
PTERO_BASE_URL=http://127.0.0.1
# Admin -> Application API, права на чтение серверов.
PTERO_APP_API_KEY=
# Client API key служебного пользователя (Account -> API Credentials).
PTERO_CLIENT_API_KEY=
# После первого старта ключи шифруются и переносятся в БД —
# эти две строки можно очистить и перезапустить сервис.

# ------------------------------------------------- первый вход (сид)
# Используется один раз командой prisma:seed, потом можно очистить.
OWNER_EMAIL=
OWNER_PASSWORD=
OWNER_NAME=ГМ
