[Unit]
# Отдельный инстанс Redis для панели.
#
# Почему не общий с Pterodactyl: Pterodactyl Panel держит в Redis сессии и
# кэш, и её политика вытеснения может выбросить наши задачи BullMQ. Плюс
# любой FLUSHALL с одной стороны ломает другую. Отдельный процесс ест
# несколько мегабайт и полностью снимает вопрос.
Description=Redis for Aurum Panel (отдельно от Pterodactyl)
After=network.target

[Service]
Type=notify
ExecStart=/usr/bin/redis-server /etc/redis/aurum.conf --supervised systemd
ExecStop=/usr/bin/redis-cli -p 6380 shutdown
TimeoutStopSec=30
Restart=always
RestartSec=5
User=redis
Group=redis
RuntimeDirectory=redis-aurum
RuntimeDirectoryMode=0755

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/redis-aurum
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
