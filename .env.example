# ==== База и кэш (значения совпадают с docker-compose.yml) ====
DATABASE_URL=postgresql://panel:panel@localhost:5432/panel?schema=public
REDIS_URL=redis://localhost:6379

# ==== API ====
API_PORT=3001
# Адрес прослушивания. По умолчанию только localhost — наружу ничего не торчит.
# В проде ставится адрес туннеля (10.0.0.1): туда ходят nginx и companion-плагин,
# а на публичном интерфейсе порт не слушается вовсе. См. deploy/DEPLOY.md.
API_BIND=127.0.0.1
# Адреса реверс-прокси, чьему X-Forwarded-For можно верить (через запятую).
# Пусто — не верить никому. В проде: 10.0.0.1
TRUST_PROXY=
# Origin фронтенда для CORS (dev: vite, prod: https://manage.aurumgg.ovh)
WEB_ORIGIN=http://localhost:5173
# В проде cookie ставится с Secure; NODE_ENV=production включает это
NODE_ENV=development

# ==== JWT ====
# Сгенерировать: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=1209600

# ==== Шифрование секретов at rest (AES-256-GCM) ====
# Сгенерировать: openssl rand -base64 32  (ровно 32 байта после декодирования)
APP_ENCRYPTION_KEY=

# ==== Pterodactyl ====
# Panel живёт на той же машине — ходим по localhost, не через публичный домен.
# Если panel за nginx с TLS-only, можно указать https://panel.aurumgg.ovh,
# но приоритет — внутренний адрес.
PTERO_BASE_URL=http://127.0.0.1
# Application API key (Admin -> Application API). Полный доступ, только бэкенд.
# При первом старте ключ шифруется и переносится в БД (integration_secrets),
# после этого переменную можно очистить.
PTERO_APP_API_KEY=
# Client API key служебного пользователя (для консоли/питания/статистики).
PTERO_CLIENT_API_KEY=

# ==== Bootstrap владельца (создаётся сидом, если БД пустая) ====
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=change-me-strong-password
OWNER_NAME=ГМ
