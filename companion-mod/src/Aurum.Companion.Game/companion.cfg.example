# Настройки Aurum Companion.
#
# Скопируйте этот файл рядом с модом под именем companion.cfg и заполните.
# Формат простой намеренно: этот файл правят на живом сервере, иногда через
# ssh и в спешке. Пропущенная строка стоит значения по умолчанию, а не
# незагрузившегося мода.

# Адрес панели ВНУТРИ приватного туннеля. Публичный домен здесь не нужен:
# трафик не должен покидать туннель.
panel-url = http://10.0.0.1:3001

# Полный UUID Aurum Panel, НЕ короткий ID Pterodactyl!
# Скопируйте строку server-id из настроек companion в Aurum Panel.
# Он также виден в URL Aurum Panel после /servers/.
server-id = замените-на-идентификатор-сервера

# Общий секрет: им мод авторизуется в панели, а панель — в моде.
# Возьмите его в панели: карточка сервера -> Настройки.
# НЕ короче 16 символов и не тот же, что где-то ещё.
token = замените-на-длинный-случайный-токен

# На каком адресе мод слушает панель.
# 127.0.0.1 — только тот же сетевой namespace (в Docker — тот же контейнер).
# Без Docker: локальный адрес игрового узла внутри туннеля, например 10.0.0.2.
# Pterodactyl/Docker: listen-host = * (без кавычек), но ТОЛЬКО с allocation
# на приватном IP игрового узла, например 10.0.0.2:8110, и доступом лишь панели.
# IP туннеля хоста обычно отсутствует внутри контейнера: bind на него не сработает.
# Не назначайте публичный allocation 8110. Токен не заменяет сетевую изоляцию.
listen-host = 127.0.0.1
listen-port = 8110

# Game chat messages: en (default), ru, pl. Unknown/missing values use English.
# Язык сообщений игрокам: en, ru или pl. После изменения перезапустите сервер.
# Język wiadomości w grze: en, ru lub pl. Zmiana wymaga restartu serwera.
language = en

# Безопасные пределы. Обычно менять не нужно. Старый cfg работает без новых строк.
# Не более 4 HTTP-обработчиков; тело <=64 KiB; чтение/запись не дольше 3 секунд.
http-max-requests = 4
http-max-body-bytes = 65536
http-io-timeout-ms = 3000
# Общий предел отправляемых ticket/report. У каждого игрока — не более одного.
ticket-max-pending = 4

# Сколько секунд игрок ждёт между обращениями. 0 — без ограничения.
ticket-cooldown-seconds = 60

# Слать ли в панель сообщения игрового чата и смерти игроков.
forward-chat = true
forward-deaths = true

# Сколько событий копить, пока панель недоступна. При переполнении
# выбрасывается самое старое.
event-queue-limit = 500
