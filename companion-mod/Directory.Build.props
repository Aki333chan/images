<Project>
  <!--
    Общие свойства всех проектов мода.

    LangVersion 11 при TargetFramework net48 — законно: язык и среда
    выполнения версионируются раздельно, компилятор Roslyn из .NET SDK 8
    умеет собирать C# 11 под .NET Framework. Это позволяет писать здесь
    современный код, не таща в процесс игры новую среду выполнения.
  -->
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <Version>1.0.10-rc.1</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
</Project>
